# The app's connection. In production use the POOLED endpoint: every serverless
# instance opens its own pool.
DATABASE_URL="postgresql://USER@localhost:5432/loveall"

# Only needed when the database has a separate unpooled endpoint (Neon,
# Supabase, Vercel Postgres do). Migrations use this, because a pooled
# connection in transaction mode cannot run them. Locally, leave it unset.
DIRECT_URL=""
AUTH_SECRET="generate one with: openssl rand -base64 32"

# Google sign-in. Create an OAuth client at https://console.cloud.google.com/apis/credentials
# Leave these unset and the Google button reports that it is not configured.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# The origin Google redirects back to. Required in production; falls back to the
# request origin in development.
APP_URL="http://localhost:3000"
